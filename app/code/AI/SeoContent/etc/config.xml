<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <ai_seo_content>
            <general>
                <enabled>0</enabled>
                <batch_size>5</batch_size>
                <enqueue_batch_size>500</enqueue_batch_size>
                <use_message_queue>1</use_message_queue>
                <queue_connection>db</queue_connection>
                <dry_run>0</dry_run>
                <only_empty_meta>1</only_empty_meta>
                <generate_meta_keyword>1</generate_meta_keyword>
                <generate_short_description>1</generate_short_description>
                <only_empty_short_description>1</only_empty_short_description>
                <request_delay_ms>3000</request_delay_ms>
            </general>
            <llm>
                <llm_provider>gemini</llm_provider>
                <gemini_model>gemini-3.5-flash-lite</gemini_model>
                <openai_model>gpt-4o-mini</openai_model>
                <anthropic_model>claude-3-5-haiku-latest</anthropic_model>
                <temperature>0.4</temperature>
            </llm>
        </ai_seo_content>
    </default>
</config>
