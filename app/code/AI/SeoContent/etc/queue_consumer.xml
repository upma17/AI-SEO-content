<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework-message-queue:etc/consumer.xsd">
    <consumer name="aiSeoContentGenerate"
              queue="ai.seo.content.generate"
              connection="db"
              maxMessages="50"
              handler="AI\SeoContent\Model\Queue\Consumer\SeoGenerationConsumer::process"/>
    <consumer name="aiSeoContentGenerateAmqp"
              queue="ai.seo.content.generate.amqp"
              connection="amqp"
              maxMessages="50"
              handler="AI\SeoContent\Model\Queue\Consumer\SeoGenerationConsumer::process"/>
</config>
