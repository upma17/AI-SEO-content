<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ai_seo_content_job_listing.ai_seo_content_job_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>ai_seo_content_job_columns</spinner>
        <deps>
            <dep>ai_seo_content_job_listing.ai_seo_content_job_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="ai_seo_content_job_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">job_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>AI_SeoContent::jobs</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="ai_seo_content_job_listing_data_source">
            <settings>
                <requestFieldName>job_id</requestFieldName>
                <primaryFieldName>job_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="retry">
                <settings>
                    <type>retry</type>
                    <label translate="true">Retry Selected</label>
                    <url path="ai_seo_content/job/massRetry"/>
                    <confirm>
                        <message translate="true">Retry selected failed/skipped jobs?</message>
                        <title translate="true">Retry jobs</title>
                    </confirm>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="ai_seo_content_job_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>job_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="job_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Job ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="sku" class="AI\SeoContent\Ui\Component\Listing\Column\ProductLink">
            <settings>
                <filter>text</filter>
                <label translate="true">SKU / Product</label>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="product_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Product ID</label>
            </settings>
        </column>
        <column name="store_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Store ID</label>
            </settings>
        </column>
        <column name="status">
            <settings>
                <filter>select</filter>
                <options class="AI\SeoContent\Model\Config\Source\JobStatus"/>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="queue_connection">
            <settings>
                <filter>select</filter>
                <options class="AI\SeoContent\Model\Config\Source\QueueConnection"/>
                <dataType>select</dataType>
                <label translate="true">Queue</label>
            </settings>
        </column>
        <column name="result_summary">
            <settings>
                <filter>text</filter>
                <label translate="true">Result</label>
            </settings>
        </column>
        <column name="error_message">
            <settings>
                <filter>text</filter>
                <label translate="true">Error</label>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Created</label>
            </settings>
        </column>
        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Updated</label>
            </settings>
        </column>
    </columns>
</listing>
